<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Portable tests: the API client and settings have no Windows dependencies, so their source
    files are compiled in directly and the suite runs on Windows, macOS and Linux.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>KvmSwitcher.Tests</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../KvmSwitcher/KvmClient.cs" Link="Linked/KvmClient.cs" />
    <Compile Include="../KvmSwitcher/AppSettings.cs" Link="Linked/AppSettings.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
